# version.h is the single source of the library release version.
# Expand the hash via a variable: escaped hashes inside $(shell ...) differ
# between GNU make 3.81 (macOS) and newer GNU make versions (Linux).
ivy_version_define := \#define
override MAJOR := $(shell awk '$$1 == "$(ivy_version_define)" && $$2 == "IVYMAJOR_VERSION" { print $$3 }' version.h)
override MINOR := $(shell awk '$$1 == "$(ivy_version_define)" && $$2 == "IVYMINOR_VERSION" { print $$3 }' version.h)
override MINOR2 := $(shell awk '$$1 == "$(ivy_version_define)" && $$2 == "IVYPATCH_VERSION" { print $$3 }' version.h)
ifneq ($(words $(MAJOR) $(MINOR) $(MINOR2)),3)
$(error cannot read version.h: IVYMAJOR_VERSION="$(MAJOR)", IVYMINOR_VERSION="$(MINOR)", IVYPATCH_VERSION="$(MINOR2)"; all three definitions are required)
endif
override VERSION := $(MAJOR).$(MINOR).$(MINOR2)
