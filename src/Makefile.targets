# Shared targets for the Linux, macOS and MinGW backends.
.PHONY: all static-libs shared-libs tools pkgconf install clean help clean-tests

help:
	@echo "Available targets:"
	@echo "  make                  build libivy using the native platform backend"
	@echo "  make static-libs      build the static library"
	@echo "  make shared-libs      build the shared library"
	@echo "  make tools            build the command-line tools"
	@echo "  make version          print the release version from version.h"
	@echo "  make pkgconf          generate pkg-config metadata"
	@echo "  make install PREFIX=/path   install libraries, headers and tools"
	@echo ""
	@echo "Static analysis (macOS, Homebrew LLVM and Python 3):"
	@echo "  make scan-build       build and generate scan-build HTML reports"
	@echo "  make tidy             build and generate clang-tidy HTML/JSON reports"
	@echo ""
	@echo "Packaging:"
	@echo "  make deb / deb_git    build Debian packages from the local working tree"
	@echo "  make deb_verify       inspect a Debian package (and run lintian if installed)"
	@echo "  make pkg              build a MinGW64 package from a checksummed release"
	@echo "  make pkg_git          build a MinGW64 package from a Git branch"
	@echo "  make pkg_verify       inspect a pacman package"
	@echo "  make check-packaging  validate recipes with fixture tools (requires Python 3)"
	@echo "  make clean_packages   remove packaging outputs"
	@echo ""
	@echo "Cleaning:"
	@echo "  make clean            remove generated libraries, objects, tools and test builds"
	@echo ""
	@echo "Tests:"
	@echo "  make check"
	@echo "  make check-caseless"
	@echo "  make sanitize"
	@echo "  make check-bus   requires a built library and sockets"
	@echo ""
	@echo "Tip: clean before switching architecture or regex build options."

clean: clean-tests

clean-tests:
	$(MAKE) -C ../tests clean

.PHONY: test check check-caseless sanitize check-bus
test: check

check check-caseless sanitize:
	$(MAKE) -C ../tests $@

check-bus: static-libs
	$(MAKE) -C ../tests $@

# Recompile the receiver when its internal parser changes.
ivy.o: ivydiscovery.h

.PHONY: version
version:
	@echo "$(VERSION)"

# Rebuild version-dependent objects after a release version change.
$(sort $(OBJ) $(OMPOBJ) $(GOBJ) $(XTOBJ) $(GLIBOBJ) $(GLUTOBJ) $(TCLOBJ)): version.h

include ../distrib/packages.mk

.PHONY: check-packaging
check-packaging:
	python3 ../tests/packaging.py

.PHONY: scan-build tidy
scan_build_jobs ?= 8
tidy_jobs ?= 4
scan_build_report_dir ?= build/scan-build-report/$(shell date +%Y%m%d-%H%M%S)
tidy_report_dir ?= build/tidy-report/$(shell date +%Y%m%d-%H%M%S)
scan-build:
	python3 ../tools/analyze_macos.py scan-build --report-dir "$(call package_path,$(scan_build_report_dir))" --jobs "$(scan_build_jobs)"

tidy:
	python3 ../tools/analyze_macos.py tidy --report-dir "$(call package_path,$(tidy_report_dir))" --jobs "$(tidy_jobs)"
