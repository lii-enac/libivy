# MSYS2 / MinGW64 command-line tools.
CC ?= gcc
PREFIX ?= /mingw64
PCRELIB = $(shell pkg-config --libs libpcre2-8)
EXTRAINC = -I../src
TARGETS = ivyprobe.exe ivyperf.exe

.PHONY: all install installbins clean
all: $(TARGETS)

%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) $(EXTRAINC) -c $< -o $@

%.exe: %.o ../src/libivy.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $< -L../src -livy $(PCRELIB) -lws2_32

install: installbins
installbins: $(TARGETS)
	mkdir -p $(DESTDIR)$(PREFIX)/bin
	install -m755 $(TARGETS) $(DESTDIR)$(PREFIX)/bin/

clean:
	rm -f $(TARGETS) *.o

ivyprobe.o ivyperf.o: ../src/version.h
